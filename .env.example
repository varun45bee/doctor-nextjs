# ==============================================================================
# Dr. Pratima Agale Clinic - Environment Variables (.env.example)
# Mirrored from Vercel Production Environment Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Base URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://doctor-whatsapp-backend.vercel.app
NEXT_PUBLIC_BASE_URL=https://www.pratimaagale.in

# ------------------------------------------------------------------------------
# 2. Doctor Access Control (Whitelist)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ALLOWED_DOCTOR_EMAIL=varun45j@gmail.com,sardarvarun121@gmail.com,madhurmeetj@gmail.com

# ------------------------------------------------------------------------------
# 3. AI Triage & CuraAI (Groq Cloud)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key

# ------------------------------------------------------------------------------
# 4. Email Service (Brevo / Sendinblue SMTP)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your_brevo_api_key
EMAIL_FROM=info@pratimaagale.in
EMAIL_FROM_NAME="Dr. Pratima Agale Clinic"

# ------------------------------------------------------------------------------
# 5. WhatsApp Cloud API (Meta Graph API)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_token
PHONE_NUMBER_ID=your_meta_phone_number_id
VERIFY_TOKEN=doctor_verify_2026
APP_SECRET=your_meta_app_secret
WHATSAPP_FLOW_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 6. Sanity CMS (Configured on Vercel)
# ------------------------------------------------------------------------------
SANITY_REVALIDATE_SECRET=""
SANITY_API_READ_TOKEN=""
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=""

# ------------------------------------------------------------------------------
# 7. Firebase Server Admin (Optional Server Operations)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=doc-web-a913f
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
