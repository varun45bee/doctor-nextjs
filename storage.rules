rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isDoctor() {
      return request.auth != null && request.auth.token.email in [
        'varun45j@gmail.com',
        'sardarvarun121@gmail.com',
        'madhurmeetj@gmail.com'
      ];
    }

    // Blog images: public read, doctor upload/delete
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if isDoctor();
    }

    // Prescriptions: Doctor read/write
    match /prescriptions/{allPaths=**} {
      allow read, write: if isDoctor();
    }

    // Patient profile photos
    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isDoctor());
    }

    // Patient medical records & diagnostic uploads
    match /medical-records/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isDoctor());
    }

    // Real-time chat attachments (reports & images shared between patient and doctor)
    match /chat-attachments/{conversationId}/{allPaths=**} {
      allow read, write: if request.auth != null && (isDoctor() || conversationId == 'conv_' + request.auth.uid);
    }

    // Default: Authenticated doctors only
    match /{allPaths=**} {
      allow read, write: if isDoctor();
    }
  }
}
